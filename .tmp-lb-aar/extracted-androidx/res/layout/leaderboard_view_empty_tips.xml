<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tap_sdk_extension_surface_white">

    <!-- 空状态图标 -->
    <ImageView
        android:id="@+id/iv_empty_icon"
        android:layout_width="200dp"
        android:layout_height="160dp"
        android:src="@drawable/ic_empty_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 主标题 -->
    <TextView
        android:id="@+id/tv_empty_title"
        style="@style/tap_china_heading_18_b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/empty_leaderboard_title"
        android:textColor="@color/tap_sdk_common_gray_08"
        app:layout_constraintEnd_toEndOf="@+id/iv_empty_icon"
        app:layout_constraintStart_toStartOf="@+id/iv_empty_icon"
        app:layout_constraintTop_toBottomOf="@+id/iv_empty_icon"
        tools:text="暂无排行榜数据" />

    <!-- 描述文本 -->
    <TextView
        android:id="@+id/tv_empty_description"
        style="@style/tap_china_heading_14_r"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/empty_leaderboard_description"
        android:textColor="@color/tap_sdk_common_gray_06"
        app:layout_constraintEnd_toEndOf="@+id/tv_empty_title"
        app:layout_constraintStart_toStartOf="@+id/tv_empty_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_empty_title" />

</androidx.constraintlayout.widget.ConstraintLayout>