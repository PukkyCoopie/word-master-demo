{
  "name": "word-master-demo",
  "private": true,
  "version": "0.3.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:apk": "npm run android:icons && npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "favicon": "node scripts/render-favicon.mjs",
    "android:icons": "node scripts/render-android-icons.mjs",
    "e2e:audit": "node e2e/static-content-audit.mjs",
    "e2e:play": "node e2e/run-auto-play.mjs",
    "e2e": "npm run e2e:audit && npm run e2e:play",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "changelog:new": "node scripts/new-changelog.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "husky": "^9.1.7",
    "opentype.js": "^1.3.4",
    "playwright": "^1.52.0",
    "sharp": "^0.34.5",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@vitejs/plugin-vue": "^6.0.5",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.14.2",
    "regl": "^2.1.0",
    "remixicon": "^4.7.0",
    "vue": "^3.5.30"
  }
}
